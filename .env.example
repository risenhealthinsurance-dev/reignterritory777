# Browser-safe Supabase configuration. Never place service-role or OpenAI keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
VITE_MAPBOX_ACCESS_TOKEN=
# Test-only bypass. Keep unset in production.
VITE_AUTH_BYPASS=false

# Server-only secrets are configured with `supabase secrets set`.
# OPENAI_API_KEY=
# Regrid MCP/API token. Do not prefix with VITE_ or expose in browser code.
# REGRID_TOKEN=
